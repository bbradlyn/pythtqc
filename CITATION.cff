    given-names: Barry
    affiliation: University of Illinois Urbana-Champaign
version: 0.1.0a2
license: GPL-3.0-or-later
repository-code: "https://github.com/bbradlyn/pythtqc"
keywords:
  - tight binding
  - space group
  - topological quantum chemistry
  - band representation
  - symmetry indicator
  - PythTB
